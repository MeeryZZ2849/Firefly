---
const USER_ID = "1102873783548776548";

// SSR fallback
let data = null;

try {
  const res = await fetch(
    `https://api.lanyard.rest/v1/users/${USER_ID}`
  );

  const json = await res.json();

  if (json.success) data = json.data;
} catch (e) {
  console.error(e);
}

const statusMap = {
  online: { text: "🟢 在线", color: "#43b581" },
  idle: { text: "🟡 离开", color: "#faa61a" },
  dnd: { text: "🔴 勿扰", color: "#f04747" },
  offline: { text: "⚫ 离线", color: "#747f8d" },
};

const status =
  statusMap[data?.discord_status] || statusMap.offline;

const avatar = data?.discord_user?.avatar
  ? `https://cdn.discordapp.com/avatars/${data.discord_user.id}/${data.discord_user.avatar}.png`
  : `https://cdn.discordapp.com/embed/avatars/0.png`;
---

<div class="discord-card" id="card">

  <!-- SKELETON -->
  {!data && (
    <div class="skeleton">
      <div class="sk-avatar"></div>
      <div class="sk-lines"></div>
    </div>
  )}

  {data && (
    <>
      <!-- TOP -->
      <div class="top">
        <div class="avatar-wrap">
          <img id="avatar" src={avatar} />
          <span id="dot" class="dot"></span>
        </div>

        <div class="user">
          <div id="name">
            {data.discord_user.global_name ||
              data.discord_user.username}
          </div>
          <div id="status">{status.text}</div>
        </div>
      </div>

      <!-- META -->
      <div class="meta">
        <div>📅 注册：{new Date(Number(BigInt(data.discord_user.id) >> 22n) + 1420070400000).toLocaleDateString()}</div>
        <div>⏳ 状态：{data.discord_status}</div>
      </div>

      <!-- GAME -->
      {data.activities?.find(a => a.type === 0 && a.name !== "Spotify") && (
        <div class="panel">
          <div class="title">🎮 正在游戏</div>
          <div class="game">
            {data.activities.find(a => a.type === 0).name}
          </div>
        </div>
      )}

      <!-- SPOTIFY -->
      {data.spotify && (
        <div class="panel spotify">
          <div class="title">🎧 Spotify</div>

          <div class="song">{data.spotify.song}</div>
          <div class="artist">{data.spotify.artist}</div>

          <div class="bar">
            <div id="progress"></div>
          </div>
        </div>
      )}
    </>
  )}
</div>

<!-- REALTIME WS -->
<script is:inline>
const USER_ID = "1102873783548776548";

const statusMap = {
  online: { text: "🟢 在线", color: "#43b581" },
  idle: { text: "🟡 离开", color: "#faa61a" },
  dnd: { text: "🔴 勿扰", color: "#f04747" },
  offline: { text: "⚫ 离线", color: "#747f8d" }
};

let ws;

function connect() {
  ws = new WebSocket("wss://api.lanyard.rest/socket");

  ws.onopen = () => {
    ws.send(JSON.stringify({
      op: 2,
      d: { subscribe_to_id: USER_ID }
    }));
  };

  ws.onmessage = (msg) => {
    const d = JSON.parse(msg.data);

    if (!d.t) return;

    if (d.t === "INIT_STATE" || d.t === "PRESENCE_UPDATE") {
      update(d.d);
    }
  };

  ws.onclose = () => setTimeout(connect, 3000);
}

function update(data) {
  if (!data) return;

  const user = data.discord_user;
  const status = statusMap[data.discord_status] || statusMap.offline;

  document.getElementById("name").textContent =
    user.global_name || user.username;

  document.getElementById("status").textContent =
    status.text;

  document.getElementById("dot").style.background =
    status.color;

  document.getElementById("avatar").src =
    `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png`;

  // Spotify progress mock (Lanyard没有实时进度，用时间模拟)
  if (data.spotify) {
    const bar = document.getElementById("progress");
    if (bar) bar.style.width = "60%";
  }
}

connect();
</script>

<style>

/* ===== CARD ===== */
.discord-card {
  padding: 1.2rem;
  border-radius: 26px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  backdrop-filter: blur(20px);

  /* 🌈 NITRO GRADIENT BORDER */
  position: relative;
  overflow: hidden;
}

.discord-card::before {
  content: "";
  position: absolute;
  inset: -2px;
  background: linear-gradient(45deg,#ff00ff,#00ffff,#ffcc00);
  z-index: -1;
  filter: blur(18px);
  opacity: .25;
  animation: glow 6s infinite linear;
}

/* ===== TOP ===== */
.top {
  display: flex;
  align-items: center;
  gap: 14px;
}

.avatar-wrap {
  position: relative;
}

#avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  animation: float 3s ease-in-out infinite;
}

/* 🌟 STATUS DOT */
.dot {
  position: absolute;
  right: 2px;
  bottom: 2px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 3px solid rgba(0,0,0,0.2);
  animation: pulse 2s infinite;
}

/* ===== TEXT ===== */
.user #name {
  font-size: 1.1rem;
  font-weight: 700;
}

#status {
  opacity: .7;
}

/* ===== META ===== */
.meta {
  margin-top: 12px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  font-size: .85rem;
  opacity: .8;
}

/* ===== PANELS ===== */
.panel {
  margin-top: 12px;
  padding: 10px;
  border-radius: 14px;
  background: rgba(255,255,255,0.04);
}

.title {
  font-size: .8rem;
  opacity: .6;
}

/* ===== SPOTIFY ===== */
.bar {
  height: 6px;
  background: rgba(255,255,255,0.1);
  border-radius: 999px;
  margin-top: 6px;
  overflow: hidden;
}

#progress {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg,#1db954,#1ed760);
}

/* ===== SKELETON ===== */
.skeleton {
  display: flex;
  gap: 12px;
}

.sk-avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  animation: shimmer 1.5s infinite;
}

.sk-lines {
  flex: 1;
  height: 40px;
  background: rgba(255,255,255,0.1);
  border-radius: 8px;
  animation: shimmer 1.5s infinite;
}

/* ===== MOBILE ===== */
@media (max-width:600px) {
  .discord-card {
    padding: 1rem;
    border-radius: 18px;
  }

  #avatar {
    width: 52px;
    height: 52px;
  }

  .meta {
    flex-direction: column;
  }
}

/* ===== ANIMATIONS ===== */
@keyframes pulse {
  0%{transform:scale(1)}
  50%{transform:scale(1.2)}
  100%{transform:scale(1)}
}

@keyframes float {
  0%{transform:translateY(0px)}
  50%{transform:translateY(-4px)}
  100%{transform:translateY(0px)}
}

@keyframes glow {
  0%{filter:hue-rotate(0deg)}
  100%{filter:hue-rotate(360deg)}
}

@keyframes shimmer {
  0%{opacity:.4}
  50%{opacity:.8}
  100%{opacity:.4}
}
</style>